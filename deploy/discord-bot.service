[Unit]
Description=Native Chinese Discord Community Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zh-discord-bot
ExecStart=/usr/bin/node /opt/zh-discord-bot/dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
